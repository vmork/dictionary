# Application database. Production uses the local Postgres service on the VPS.
DATABASE_URL=postgresql://dictionary:replace-me@127.0.0.1:5432/dictionary
DATABASE_POOL_SIZE=5
AUTH_DATABASE_POOL_SIZE=5

# Authentication. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Optional development-only account setup. The setup command additionally
# requires an explicitly enabled local database whose name contains dev/test.
DICTIONARY_ENABLE_DEV_ACCOUNT=0
DICTIONARY_DEV_EMAIL=codex-dev@dictionary.invalid
DICTIONARY_DEV_NAME=Codex development
DICTIONARY_DEV_PASSWORD=replace-with-at-least-12-characters

# Server-only keys. Do not prefix these with NEXT_PUBLIC_.
MERRIAM_WEBSTER_API_KEY_DICTIONARY=replace-me
MERRIAM_WEBSTER_API_KEY_THESAURUS=replace-me
